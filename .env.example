# Copiar a .env.local para desarrollo, o cargar en Vercel (Project → Settings → Environment Variables).
# Sin RESEND_API_KEY, en desarrollo las consultas se imprimen en la consola; en producción el formulario
# muestra un error con el email directo (no se pierde la consulta, pero tampoco llega).

# Obligatoria en producción: API key de https://resend.com (o la integración de Resend en Vercel).
RESEND_API_KEY=

# A qué email llegan las consultas. Por defecto: site.email en lib/site.ts.
CONTACT_TO=

# Remitente. Para mandar desde @greschek-obras.com hay que verificar el dominio en Resend.
# Por defecto: "Web Greschek <onboarding@resend.dev>" (solo sirve para pruebas).
CONTACT_FROM=
